{
  "name": "knowledge-loom",
  "version": "0.6.0",
  "private": true,
  "description": "Agent-neutral governance and skills for local Markdown knowledge vaults",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mike Xiao",
    "url": "https://github.com/magickaichen"
  },
  "homepage": "https://github.com/magickaichen/knowledge-loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/magickaichen/knowledge-loom.git"
  },
  "bugs": {
    "url": "https://github.com/magickaichen/knowledge-loom/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "knowledge-loom": "skills/use-knowledge-vault/scripts/knowledge-loom.mjs"
  },
  "scripts": {
    "build": "node scripts/build-skill-packages.mjs && node scripts/build-claude-desktop-skill.mjs",
    "build:check": "node scripts/build-skill-packages.mjs --check",
    "cli": "tsx src/knowledge-loom/runner.ts",
    "install:skills": "tsx scripts/install.mjs",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate.mjs",
    "validate:npx": "node scripts/validate.mjs --npx"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
