{
  "name": "knowledge-loom",
  "version": "0.8.0",
  "private": true,
  "description": "Agent-neutral governance and skills for local Markdown knowledge vaults",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mike Xiao",
    "url": "https://github.com/magickaichen"
  },
  "homepage": "https://github.com/magickaichen/knowledge-loom",
  "repository": {
    "type": "git",
    "url": "https://github.com/magickaichen/knowledge-loom.git"
  },
  "bugs": {
    "url": "https://github.com/magickaichen/knowledge-loom/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "knowledge-loom": "skills/use-knowledge-vault/scripts/knowledge-loom.mjs"
  },
  "scripts": {
    "build": "node --import tsx scripts/build-skill-packages.ts && node --import tsx scripts/build-claude-desktop-skill.ts",
    "build:check": "node --import tsx scripts/build-skill-packages.ts --check",
    "cli": "node --import tsx src/knowledge-loom/runner.ts",
    "install:skills": "node --import tsx scripts/install.ts",
    "test": "node --import tsx scripts/run-tests.ts",
    "typecheck": "tsc --noEmit",
    "validate": "node --import tsx scripts/validate.ts",
    "validate:npx": "node --import tsx scripts/validate.ts --npx"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
